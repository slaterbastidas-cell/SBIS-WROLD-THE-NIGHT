extends Node3D

func _ready() -> void:
	$WorldEnvironment.environment = _build_environment()
	if has_node("WorldSun"):
		var sun: DirectionalLight3D = $WorldSun
		sun.light_energy = 1.8
		sun.light_color = Color(0.75, 0.82, 0.92)
		sun.shadow_enabled = false
		sun.rotation_degrees = Vector3(-40, -30, 0)
	WorldManager.update_player_position($ExplorerCamera.global_position)
	$Aethermoor/Streaming.update_streaming(WorldManager.player_world_position)

func _process(_delta: float) -> void:
	$Aethermoor/Streaming.update_streaming(WorldManager.player_world_position)

func _build_environment() -> Environment:
	var environment := Environment.new()
	environment.background_mode = Environment.BG_SKY

	var sky := Sky.new()
	var sky_material := ProceduralSkyMaterial.new()
	sky_material.sky_top_color = Color(0.02, 0.03, 0.06)
	sky_material.sky_horizon_color = Color(0.12, 0.16, 0.22)
	sky_material.ground_bottom_color = Color(0.03, 0.04, 0.06)
	sky_material.ground_horizon_color = Color(0.08, 0.10, 0.14)
	sky_material.sun_angle_max = 12.0
	sky.sky_material = sky_material
	environment.sky = sky

	environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	environment.ambient_light_color = Color(0.55, 0.65, 0.80)
	environment.ambient_light_energy = 0.75
	environment.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	environment.tonemap_exposure = 1.25

	environment.fog_enabled = true
	environment.fog_light_color = Color(0.25, 0.32, 0.40)
	environment.fog_light_energy = 0.2
	environment.fog_density = 0.0002
	environment.fog_sky_affect = 0.35
	return environment
